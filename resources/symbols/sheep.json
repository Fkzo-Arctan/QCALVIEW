{
  "id": "sheep",
  "name": "Ovin / mouton",
  "category": "Animaux",
  "description": "Silhouette schématique d’ovin pour pâturage et projets agrivoltaïques.",
  "geometry": [
    "point",
    "polygon"
  ],
  "generator": "billboard_svg",
  "fallback": "animal",
  "parameters": {
    "height_m": {
      "source": "layer_height",
      "default": 0.9,
      "label": "Hauteur (m)"
    },
    "width_m": {
      "default": 1.3,
      "field": "qcv_width",
      "label": "Largeur (m)"
    },
    "svg": "assets/sheep.svg",
    "spacing_m": {
      "default": 5.0,
      "label": "Espacement dispersion polygonale (m)"
    },
    "position_jitter": {
      "default": 0.18,
      "label": "Irrégularité position (0–0,45)"
    },
    "max_instances": {
      "default": 400,
      "label": "Nombre maximum sur polygone"
    }
  },
  "appearance": {
    "fill_alpha": 255
  },
  "lod": {
    "detailed_min_px": 12,
    "simple_min_px": 2
  },
  "taxonomy_type": "animals",
  "taxonomy_family": "sheep"
}
