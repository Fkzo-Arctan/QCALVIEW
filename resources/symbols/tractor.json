{
  "id": "tractor",
  "name": "Tracteur agricole",
  "category": "Agriculture",
  "description": "Silhouette latérale schématique d’un tracteur, dimensionnable en mètres.",
  "geometry": [
    "point",
    "polygon"
  ],
  "generator": "billboard_svg",
  "fallback": "vehicle",
  "parameters": {
    "height_m": {
      "source": "layer_height",
      "default": 2.8,
      "label": "Hauteur (m)"
    },
    "width_m": {
      "default": 5.0,
      "field": "qcv_width",
      "label": "Largeur (m)"
    },
    "svg": "assets/tractor.svg",
    "spacing_m": {
      "default": 10.0,
      "label": "Espacement dispersion polygonale (m)"
    },
    "position_jitter": {
      "default": 0.18,
      "label": "Irrégularité position (0–0,45)"
    },
    "max_instances": {
      "default": 400,
      "label": "Nombre maximum sur polygone"
    }
  },
  "appearance": {
    "fill_alpha": 255
  },
  "lod": {
    "detailed_min_px": 12,
    "simple_min_px": 2
  },
  "taxonomy_type": "vehicles",
  "taxonomy_family": "tractors"
}
