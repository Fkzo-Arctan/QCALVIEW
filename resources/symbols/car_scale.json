{
  "id": "car_scale",
  "name": "Voiture — échelle",
  "category": "Repères",
  "description": "Silhouette de voiture pour donner une échelle ou représenter un véhicule léger.",
  "geometry": [
    "point",
    "polygon"
  ],
  "generator": "billboard_svg",
  "fallback": "vehicle",
  "parameters": {
    "height_m": {
      "source": "layer_height",
      "default": 1.5,
      "label": "Hauteur (m)"
    },
    "width_m": {
      "default": 4.5,
      "field": "qcv_width",
      "label": "Largeur (m)"
    },
    "svg": "assets/car.svg",
    "spacing_m": {
      "default": 9.0,
      "label": "Espacement dispersion polygonale (m)"
    },
    "position_jitter": {
      "default": 0.18,
      "label": "Irrégularité position (0–0,45)"
    },
    "max_instances": {
      "default": 400,
      "label": "Nombre maximum sur polygone"
    }
  },
  "appearance": {
    "fill_alpha": 255
  },
  "lod": {
    "detailed_min_px": 12,
    "simple_min_px": 2
  },
  "taxonomy_type": "vehicles",
  "taxonomy_family": "cars"
}
