{
  "id": "pv_vertical",
  "name": "Panneaux photovoltaïques verticaux",
  "description": "Rangée photovoltaïque verticale (bifaciale possible en représentation schématique). Sur ligne, la surface s’élève verticalement depuis la ligne d’axe.",
  "geometry": [
    "line",
    "polygon"
  ],
  "generator": "pv_surface",
  "parameters": {
    "pv_mode": {
      "default": "vertical",
      "label": "Mode photovoltaïque",
      "choices": [
        {
          "value": "vertical",
          "label": "Panneau vertical (90°)"
        },
        {
          "value": "fixed",
          "label": "Table fixe inclinée"
        }
      ]
    },
    "low_height_m": {
      "source": "layer_height",
      "default": 0.4,
      "label": "Garde au sol basse (m)"
    },
    "tilt_deg": {
      "default": 90.0,
      "min": 0.0,
      "max": 90.0,
      "step": 1.0,
      "decimals": 1,
      "label": "Inclinaison (°)"
    },
    "azimuth_deg": {
      "field": "azimuth",
      "default": 180.0,
      "min": 0.0,
      "max": 360.0,
      "step": 1.0,
      "decimals": 1,
      "label": "Azimut face haute (°)"
    },
    "table_width_m": {
      "field": "width",
      "default": 2.4,
      "min": 0.1,
      "max": 20.0,
      "step": 0.1,
      "decimals": 2,
      "label": "Hauteur/largeur physique du panneau (m)"
    },
    "show_supports": {
      "default": true,
      "label": "Afficher les pieds verticaux"
    },
    "support_width_m": {
      "default": 0.08,
      "min": 0.01,
      "max": 0.5,
      "step": 0.01,
      "decimals": 3,
      "label": "Épaisseur des pieds (m)"
    }
  },
  "appearance": {
    "pattern": "pv",
    "fill_alpha": 255,
    "outline_alpha": 255
  },
  "lod": {
    "detailed_min_px": 16,
    "simple_min_px": 2
  },
  "category": "Énergie / ENR",
  "taxonomy_type": "solar_panels",
  "taxonomy_family": "vertical_panels"
}
